<UserControl x:Class="Altaxo.Gui.Chat.ChatServiceInstanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Altaxo.Gui.Chat;assembly=AltaxoDom"
             d:DataContext="{d:DesignInstance Type=local:ChatServiceInstanceController}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Service type:"/>
        <ComboBox Grid.Row="2" ItemsSource="{Binding ServiceTypes.Items}" SelectedItem="{Binding ServiceTypes.SelectedItem, Mode=TwoWay}"/>

        <Label Grid.Row="4" Content="Service details:"/>
        <ContentControl Grid.Row="6" Content="{Binding InstanceController.ViewObject}"/>
    </Grid>
</UserControl>
