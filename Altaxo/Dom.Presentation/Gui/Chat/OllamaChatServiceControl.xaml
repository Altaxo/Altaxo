<UserControl x:Class="Altaxo.Gui.Chat.OllamaChatServiceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Altaxo.Gui.Chat;assembly=AltaxoDom" 
             xmlns:axogc="clr-namespace:Altaxo.Gui.Common;assembly=AltaxoBase.Presentation"
             d:DataContext="{d:DesignInstance Type=local:OllamaChatServiceController}"
             mc:Ignorable="d" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
        </Grid.ColumnDefinitions>

        <Label Content="Base Uri:"
       Grid.Row="0"
       Grid.Column="0" />
        <TextBox Grid.Row="0"
         Grid.Column="2"
         Text="{Binding BaseUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Label Content="Model:"
       Grid.Row="2"
       Grid.Column="0" />
        <ComboBox Grid.Row="2"
                  Grid.Column="2"
                  IsEditable="True"
                  ItemsSource="{Binding Models}"
                  Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Label Content="API key:"
       Grid.Row="4"
       Grid.Column="0" />
        <TextBox Grid.Row="4"
         Grid.Column="2"
         Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox Content="Context length:"
                Grid.Row="6"
                    Grid.Column="0" 
                  IsChecked="{Binding IsContextLengthEnabled, Mode=TwoWay}"
                  />
        <axogc:Int32UpDown Grid.Row="6"
             Grid.Column="2"
                           Minimum="0"
                           Value="{Binding ContextLength}"
                           IsEnabled="{Binding IsContextLengthEnabled}"
   />

        <CheckBox Content="Temperature:"
             Grid.Row="8"
                 Grid.Column="0"
                  IsChecked="{Binding IsTemperatureEnabled, Mode=TwoWay}"
                  />
        <axogc:NumericDoubleTextBox      Grid.Row="8"
          Grid.Column="2"
                        SelectedValue="{Binding Temperature}"
                        IsEnabled="{Binding IsTemperatureEnabled}"
/>


        <CheckBox Content="Max. number of tokens to generate:"
             Grid.Row="10"
                 Grid.Column="0"
                  IsChecked="{Binding IsMaximumNumberOfTokensToGenerateEnabled, Mode=TwoWay}"
                  />
        <axogc:Int32UpDown Grid.Row="10"
          Grid.Column="2"
                        Minimum="0"
                        Value="{Binding MaximumNumberOfTokensToGenerate}"
                        IsEnabled="{Binding IsMaximumNumberOfTokensToGenerateEnabled}"
/>

        <Label Content="Max. number of tool call rounds:"
             Grid.Row="12"
                 Grid.Column="0" />
        <axogc:Int32UpDown Grid.Row="12"
          Grid.Column="2"
                        Minimum="0"
                        Value="{Binding MaximumNumberOfToolCallRounds}"
/>


        <Label Content="Thinking:" Grid.Row="14" Grid.Column="0" />
        <StackPanel Orientation="Horizontal" Grid.Row="14" Grid.Column="2">
            <RadioButton Content="Default" IsChecked="{Binding ThinkDefault, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Uses the model's default value"/>
            <RadioButton Content="No" IsChecked="{Binding ThinkNo, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Thinking is disabled"/>
            <RadioButton Content="Yes" IsChecked="{Binding ThinkYes, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Thinking is enabled if the model supports it"/>
        </StackPanel>

        <Label Content="Keep alive time:" Grid.Row="16" Grid.Column="0" />
        <axogc:QuantityWithUnitTextBox Grid.Row="16" Grid.Column="2"
                                      SelectedQuantity="{Binding KeepAliveTime, Mode=TwoWay}"
                                       UnitEnvironment="{Binding EnvironmentForTime}"
                                       ToolTip="Specifies the time after the last message before the LLM model is unloaded."
                                       />

        <Label Content="Message timeout:" Grid.Row="18" Grid.Column="0" />
        <axogc:QuantityWithUnitTextBox Grid.Row="18" Grid.Column="2"
                                      SelectedQuantity="{Binding MessageTimeout, Mode=TwoWay}"
                                       UnitEnvironment="{Binding EnvironmentForTime}"
                                       ToolTip="Specifies the time to wait for a message response before timing out."
                                       />
        
        <CheckBox Grid.Row="20" Grid.Column="0" Grid.ColumnSpan="3"
                  IsChecked="{Binding UseStreaming, Mode=TwoWay}"
                  Content="Use streaming for receiving responses" />
        <CheckBox Grid.Row="22" Grid.Column="0" Grid.ColumnSpan="3"
                  IsChecked="{Binding LogToConsole, Mode=TwoWay}"
                  Content="Log messages to Altaxo's output window" />

    </Grid>
</UserControl>
