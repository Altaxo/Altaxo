<UserControl x:Class="Altaxo.Gui.Chat.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:axog="clr-namespace:Altaxo.Gui;assembly=AltaxoBase.Presentation"
             xmlns:chat="clr-namespace:Altaxo.Gui.Chat;assembly=AltaxoDom"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance Type=chat:ChatController}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Style for a TextBox that allows text selection but is read-only -->
        <!-- if someday there is a SelectableTextBox control, this style can be removed -->
        <Style x:Key="SelectableTextStyle"
           TargetType="TextBox">
            <Setter Property="IsReadOnly"
              Value="True" />
            <Setter Property="IsReadOnlyCaretVisible"
              Value="False" />
            <Setter Property="TextWrapping"
              Value="Wrap" />
            <Setter Property="Background"
              Value="Transparent" />
            <Setter Property="BorderThickness"
              Value="0" />
            <Setter Property="Padding"
              Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="0,0,0,1"
                    Padding="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="Bold" />
                                <!-- Make the chat text selectable, so the user can copy it. That's why we use a TextBox instead of a TextBlock -->
                                <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableTextStyle}" />
                                <TextBlock Text="{Binding AttachmentName}" FontStyle="Italic" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="1" LastChildFill="False">
            <TextBlock Text="{Binding PendingImageName}" VerticalAlignment="Center" />
            <Button Content="Remove image" Command="{Binding CmdRemoveImage}" Margin="8,0,0,0" DockPanel.Dock="Right" />
        </DockPanel>
        <TextBox Grid.Row="2"
             Margin="0,8,0,0"
             MinHeight="64"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
             PreviewKeyDown="EhInputPreviewKeyDown" />
        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Content="Send" Command="{Binding CmdSend}" MinWidth="72" Margin="8,0,0,0" DockPanel.Dock="Right" 
              ToolTip="Sends the current chat message. You can also press ENTER to do that. In contrast, SHIFT-ENTER will create a new line."
              />
            <Button Content="Cancel" Command="{Binding CmdCancel}" MinWidth="72" Margin="8,0,0,0" DockPanel.Dock="Right" 
              ToolTip="Cancels processing of the current chat message."
              />
            <Button Content="Attach image" 
              Command="{Binding CmdAttachImage}"
              MinWidth="96"                     Margin="8,0,0,0"                     DockPanel.Dock="Right"
              ToolTip="Attaches an image from the file system. For inserting an image from the clipboard, press CTRL-C."
              />
            <Button Command="{Binding CmdShowSettings}"
              DockPanel.Dock="Right"
              ToolTip="Edits the settings for the chat service provider.">
                <Image Source="{axog:GetBitmap Icons.16x16.Settings}" Width="16" Height="16" />
            </Button>
        </DockPanel>
    </Grid>
</UserControl>
