<UserControl x:Class="Altaxo.Gui.Actions.Viewing.ActionDocumentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Altaxo.Gui.Actions.Viewing;assembly=AltaxoDom" 
             d:DataContext="{d:DesignInstance Type=local:ActionDocumentController}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
        <TextBlock Text="{Binding ActionDescription}" TextWrapping="NoWrap" Margin="0,0,0,10" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        <ContentControl Content="{Binding ActionController.ViewObject}"/>
        <Button Content="Execute Action" Command="{Binding CmdExecute}" HorizontalAlignment="Center"/>
    </StackPanel>
    </ScrollViewer>
</UserControl>
