<UserControl x:Class="Altaxo.Gui.Serialization.NamePropertyExtraction.ActionPutToPropertyBagControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Altaxo.Gui.Serialization.NamePropertyExtraction;assembly=AltaxoBase"
             xmlns:axogc="clr-namespace:Altaxo.Gui.Common"
             d:DataContext="{d:DesignInstance Type=local:ActionPutToPropertyBagController}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Property Name:" />
        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding PropertyName, Mode=TwoWay}" />
        
        <Label Grid.Row="2" Grid.Column="0" Content="Level:" />
        <axogc:Int32UpDown Grid.Row="2" 
                           Grid.Column="2"
                           Value="{Binding Level, Mode=TwoWay}" Maximum="0" 
                           ToolTip="The level to put the property into. 0 means to put the property in the target table, -1 means in the property bag containing this table, -2 the is the parent folder of this folder, etc..."/>

    </Grid>
</UserControl>
