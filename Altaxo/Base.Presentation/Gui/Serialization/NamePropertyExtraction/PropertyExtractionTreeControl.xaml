<UserControl x:Class="Altaxo.Gui.Serialization.NamePropertyExtraction.PropertyExtractionTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:localm="clr-namespace:Altaxo.Gui.Serialization.NamePropertyExtraction;assembly=AltaxoBase"  
             xmlns:collm="clr-namespace:Altaxo.Collections;assembly=AltaxoBase"
             xmlns:axogb="clr-namespace:Altaxo.Gui.Behaviors"
             d:DataContext="{d:DesignInstance Type=localm:PropertyExtractionTreeController}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <axogb:BindingProxy x:Key="gcontext" Data="{Binding}" />
        </Grid.Resources>
        <TreeView ItemsSource="{Binding RootNode.Nodes}">

            <ItemsControl.ItemContainerStyle>
                <!--  This Style binds a TreeViewItem to a TreeViewItemViewModel.  -->
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </ItemsControl.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Nodes}" DataType="{x:Type collm:NGTreeNode}">
                    <StackPanel Orientation="Horizontal" axogb:DoubleClickTriggersCommand.IsHandled="True" axogb:DoubleClickTriggersCommand.Command="{Binding Source={StaticResource gcontext}, Path=Data.CmdEditNode}" axogb:DoubleClickTriggersCommand.CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Text}" Margin="4 0 4 0" VerticalAlignment="Center" />
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add child splitter" ItemsSource="{Binding Source={StaticResource gcontext}, Path=Data.AvailableSplitterTypesForAddition}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                            <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.DataContext}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <MenuItem Header="Add child evaluator" ItemsSource="{Binding Source={StaticResource gcontext}, Path=Data.AvailableEvaluatorTypesForAddition}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                            <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.DataContext}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <MenuItem Header="Change type to" ItemsSource="{Binding Source={StaticResource gcontext}, Path=Data.AvailableTypesForChanging}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                            <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.DataContext}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <MenuItem Header="Remove" Command="{Binding Source={StaticResource gcontext}, Path=Data.CmdRemoveNode}"  CommandParameter="{Binding}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
            
    </Grid>
</UserControl>
