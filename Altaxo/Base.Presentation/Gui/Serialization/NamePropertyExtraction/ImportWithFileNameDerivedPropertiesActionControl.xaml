<UserControl x:Class="Altaxo.Gui.Serialization.NamePropertyExtraction.ImportWithFileNameDerivedPropertiesActionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:localm="clr-namespace:Altaxo.Gui.Serialization.NamePropertyExtraction;assembly=AltaxoBase"
             xmlns:axogc="clr-namespace:Altaxo.Gui.Common"
             xmlns:axogb="clr-namespace:Altaxo.Gui.Behaviors"
             d:DataContext="{d:DesignInstance Type=localm:ImportWithFileNameDerivedPropertiesActionController}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>

            <Grid.Resources>
                <axogb:BindingProxy x:Key="gcontext" Data="{Binding}" />
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />



            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="File names:" />

            <TextBox Grid.Row="2"
                 Grid.Column="0" 
                 Text="{Binding FileNames, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 ToolTip="Enter the file names to be imported, separated by new lines. The file names may contain joker characters * and/or ?."
                 />

            <Button Grid.Row="2" Grid.Column="2" Content="Add files ..." Command="{Binding CmdAddFiles}"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Property extraction:" />

            <ContentControl Grid.Row="6" Grid.Column="0" MinHeight="80" Content="{Binding TreeController.ViewObject}" />

            <Expander Header="Property Preview" Grid.Row="8">
                <DataGrid ItemsSource="{Binding RowsOfPropertyPreview}"
          AutoGenerateColumns="True"
          IsReadOnly="True" />
            </Expander>

            <Label Grid.Row="10" Grid.Column="0" Content="Target table name template (use property names in curly braces {}, like {SampleName} :" />


            <TextBox Grid.Row="12"
            Grid.Column="0" 
            Text="{Binding TableTargetName, UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            ToolTip="Enter the full target table names. Use the properties, e.g. 'SampleName' like this: Foo\Bar\{SampleName}\WData"
            />

            <Expander Header="Target table name preview" Grid.Row="14">
                <DataGrid ItemsSource="{Binding RowsOfTargetTablePreview}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True" />
            </Expander>
            
            <Label Grid.Row="16" Grid.Column="0" Content="Project folder or table name used as template if target table is missing:" />
            <TextBox Grid.Row="18"
                     Grid.Column="0"
                     Text="{Binding FolderOrTableNameUsedAsTemplateIfTargetTableIsMissing, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Enter the project folder name (with trailing backslash) or table name to be used as a template if the target table is missing."
                     />

            <Label Grid.Row="20" Grid.Column="0" Content="Actions to put properties into the property bag:" />

            <DataGrid Grid.Row="22"
                  Grid.Column="0"
                  MinHeight="80"
                  ItemsSource="{Binding ActionsPutToPropertyBag}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserResizeColumns="True"
                  >
                <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="Property name"  
                                        ItemsSource="{Binding Source={StaticResource gcontext}, Path=Data.PropertyNames}"
                                        SelectedValueBinding="{Binding Name}" />
                    <DataGridTemplateColumn Header="Level">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <axogc:Int32UpDown Value="{Binding Level}" Minimum="-1000" Maximum="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Expander Header="Property bag preview" Grid.Row="24">
                <DataGrid ItemsSource="{Binding RowsOfPropertyBagPreview}"
          AutoGenerateColumns="True"
          IsReadOnly="True" />
            </Expander>


        </Grid>
    </ScrollViewer>
</UserControl>
