<UserControl x:Class="Altaxo.Gui.Serialization.NamePropertyExtraction.DoublePropertyEvaluatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:localm="clr-namespace:Altaxo.Gui.Serialization.NamePropertyExtraction;assembly=AltaxoBase" 
             xmlns:axogc="clr-namespace:Altaxo.Gui.Common"
             xmlns:axogcb="clr-namespace:Altaxo.Gui.Common.BasicTypes"
             d:DataContext="{d:DesignInstance Type=localm:DoublePropertyEvaluatorController}"
             mc:Ignorable="d">
    <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn1"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="EditColumn1"/>
            <ColumnDefinition Width="4"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>
        
        <Label Grid.Row="0" Grid.Column="0" Content="Property name:"/>
        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}"/>
        
        <Label Grid.Row="2" Grid.Column="0" Content="Ignore leading #chars:"/>
        
        <axogc:Int32UpDown Grid.Row="2" Grid.Column="2" Value="{Binding NumberOfIgnoredCharactersBefore}" Minimum="0"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Ignore trailing #chars:"/>

        <axogc:Int32UpDown Grid.Row="4" Grid.Column="2" Value="{Binding NumberOfIgnoredCharactersAfter}" Minimum="0"/>


        <Label Grid.Row="6" Grid.Column="0" Content="Culture:"/>
        
        <ComboBox Grid.Row="6" Grid.Column="2" ItemsSource="{Binding Cultures.Items}" SelectedItem="{Binding Cultures.SelectedItem}"/>

        <Label Grid.Row="8" Grid.Column="0" Content="Number styles:"/>

        <axogcb:EnumValueControl Grid.Row="8" 
                                          Grid.Column="2" 
                                            DataContext="{Binding NumberStylesController}"
                                          />

    </Grid>
</UserControl>
