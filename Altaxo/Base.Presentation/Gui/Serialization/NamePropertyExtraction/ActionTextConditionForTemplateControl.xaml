<UserControl x:Class="Altaxo.Gui.Serialization.NamePropertyExtraction.ActionTextConditionForTemplateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Altaxo.Gui.Serialization.NamePropertyExtraction;assembly=AltaxoBase"
             xmlns:axogc="clr-namespace:Altaxo.Gui.Common"
             d:DataContext="{d:DesignInstance Type=local:ActionTextConditionForTemplateController}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Property Name:" />
        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding PropertyName, Mode=TwoWay}" />
        
        <Label Grid.Row="2" Grid.Column="0" Content="If property value:" />
        <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ConditionComparisonKind.Items}" SelectedItem="{Binding ConditionComparisonKind.SelectedItem, Mode=TwoWay}" />
        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Condition, Mode=TwoWay}" MinWidth="100" />
        <CheckBox Grid.Row="2" Grid.Column="6" IsChecked="{Binding IsConditionCaseSensitive, Mode=TwoWay}" Content="Compare case sensitive" VerticalAlignment="Center" />
        
        <Label Grid.Row="4" Grid.Column="0" Content="Then copy project items:" />
        <TextBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5" Text="{Binding ProjectItemsUsedAsTemplate, Mode=TwoWay}" AcceptsReturn="True" />
        
        <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="7" Header="If project items already exist in the target folder, then:">
                <axogc:SingleChoiceRadioStackPanel Orientation="Horizontal" ItemsSource="{Binding OverwriteProjectItems.Items}" SelectedItem="{Binding OverwriteProjectItems.SelectedItem, Mode=TwoWay}" />
        </GroupBox>
    </Grid>
</UserControl>
